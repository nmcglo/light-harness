# Example configuration file.
#
# Copy to $LIGHT_HARNESS_HOME/config.yaml (default: ~/.light-harness/config.yaml).
# The file is optional. Precedence: config file > built-in default.
# Values may reference env vars ($NAME or ${NAME}); set vars are substituted and
# unset ones are left as-is.
#
# Credentials never go in this file. `secrets:` names each one by reference
# (env:NAME or file:PATH) plus the policy saying which tools, hosts, agents and
# interactions may use it. A provider `api_key` or webhook `secret` references one
# as secret:NAME (or $NAME, registered as env:NAME). An unresolved reference clears
# the key / disables the webhook (with a warning); it is never used literally.
#
# `providers:` defines the endpoints you can use. Each provider lists the models it
# offers (the set you can switch among).
#
# `agents:` is a list of named agents. Each agent picks a `provider`, `model`, an
# optional `tools` list (opt-in), an optional `persona` (a key under `personas:`),
# and optional `secrets` bindings (purpose -> secret name).
#
# `personas:` names the personas. Each named persona gets a directory under
# LIGHT_HARNESS_HOME -- personas/<name>/ -- holding its SOUL.md plus a sessions/
# directory of conversation logs. The SOUL.md value below seeds that file on first
# run and becomes the system prompt for any agent that references the persona.
#
# `interaction:` names which agent each interaction uses. `chat.agent` is the agent
# the `agent chat` loop runs.
#
# `webhooks:` names HTTP paths that trigger a specific agent. Each entry has a
# `path`, an `agent` (a name under `agents:`), an optional `secret` that, when
# set, requires `Authorization: Bearer <secret>`, and an optional `system_prompt`
# that overrides the agent's default system prompt. `agent webhooks` serves them.
# `webhook_server:` tunes `agent webhooks`: `host`, `port`, extra `allowed_hosts`,
# and `output_log` (log each webhook call, naming its run's session log file).
#
# There are no per-field env overrides. LIGHT_HARNESS_HOME overrides the home dir.

secrets:
  # A Forgejo API token. The Forgejo tools look it up by the instance's host;
  # the model never sees or names it. Default deny: without both `tools` and
  # `hosts` under `allow`, no tool may use a secret.
  forgejo_main:
    source: env:FORGEJO_TOKEN          # or file:/path, or file:secrets/name (in home)
    allow:
      tools: [forgejo_pr, forgejo_pr_diff, forgejo_pr_comment, forgejo_clone]
      hosts: [git.example.com]
      agents: [assistant]              # optional; omitted = any agent
      interactions: [chat, webhook]    # optional; omitted = both
    confirm: never                     # never | once-per-session | always (chat only)
    # expires: 2027-01-01
    # deny_after_untrusted: true       # refuse once webhook/issue/PR text is in the chat
  # Provider keys need no `allow`: their own `api_key` field may always use them.
  openai:
    source: env:OPENAI_API_KEY
  deploy_hook:
    source: env:DEPLOY_WEBHOOK_SECRET

providers:
  local:
    base_url: http://127.0.0.1:8000/v1
    api_key: $LOCAL_API_KEY            # $NAME works too
    timeout: 60
    models:
      - qwen3.8:27b
  openai:
    base_url: https://api.openai.com/v1
    api_key: secret:openai
    models:
      - gpt-4o-mini
      - gpt-4o

agents:
  - name: assistant
    provider: local
    model: qwen3.8:27b
    # Optional opt-in list of built-in tools: current_time, the file tools
    # read_file/write_file/edit_file, and the Forgejo tools (forgejo_pr, forgejo_pr_diff,
    # forgejo_pr_comment, forgejo_pr_comment_edit, forgejo_pr_comment_delete,
    # forgejo_pr_review, forgejo_pr_review_delete, forgejo_pr_create, forgejo_pr_close,
    # forgejo_pr_merge, forgejo_issue_create, forgejo_issue_list, forgejo_issue,
    # forgejo_issue_update, forgejo_issue_comment, forgejo_issue_comment_edit,
    # forgejo_issue_comment_delete, forgejo_clone). Omit for
    # all available; [] for none.
    # The file tools and forgejo_clone need a `workspace` (absolute directory); without
    # one they are unavailable even if listed. Everything the agent writes stays inside it.
    tools:
      - current_time
    # Optional persona (a key under `personas:`); its SOUL.md becomes the system prompt.
    persona: default
    # Optional: pin the secret the Forgejo tools use (its policy still applies).
    # secrets:
    #   forgejo: forgejo_main
  - name: terse
    provider: openai
    model: gpt-4o-mini

personas:
  # A named persona. Each gets LIGHT_HARNESS_HOME/personas/<name>/ holding its
  # SOUL.md and a sessions/ directory of conversation logs. The SOUL.md value seeds
  # the file on first run and becomes the system prompt for agents using this persona.
  default:
    SOUL.md: You are a helpful, concise assistant.

interaction:
  chat:
    # The agent the `agent chat` loop runs (a name under `agents:`).
    agent: assistant

webhooks:
  # Each entry: a `path`, the `agent` that handles it (a name under `agents:`), an
  # optional `secret` (requires `Authorization: Bearer <secret>`), and an optional
  # `system_prompt` that overrides the agent's default system prompt.
  - path: /hooks/deploy
    agent: assistant
    secret: secret:deploy_hook
  - path: /hooks/issues
    agent: terse
    system_prompt: You are a terse issue-triage bot.

webhook_server:
  # Optional settings for `agent webhooks` (the CLI flags override these).
  # host: 127.0.0.1
  # port: 8787
  # allowed_hosts: [hooks.example]
  # Print a log line for each accepted webhook call, naming the session log
  # file of its run, to the server's stdout. --output-log / --no-output-log override.
  # output_log: true
