# Copy to .env. `agent` loads ./.env at startup (variables already set in the
# environment win). Reference these from config.yaml as $NAME -- see
# config.yaml.example. The only variable the harness itself reads is
# AGENT_RESPONDER_HOME (config/persona home; default ~/.agent-responder).
LOCAL_API_KEY=dummy
OPENAI_API_KEY=
DEPLOY_WEBHOOK_SECRET=
