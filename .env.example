# Copy to .env. `agent` loads ./.env at startup (variables already set in the
# environment win). config.yaml references these from its `secrets:` section
# (source: env:NAME) or as $NAME -- see config.yaml.example. The only variable the
# harness itself reads is LIGHT_HARNESS_HOME (config/persona home; default
# ~/.light-harness). Keep this file out of any agent's workspace.
LOCAL_API_KEY=dummy
OPENAI_API_KEY=
DEPLOY_WEBHOOK_SECRET=
FORGEJO_TOKEN=
